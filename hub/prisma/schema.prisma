// Ѫ
// Shared by hub, landing, and play. PostgreSQL. Apply migrations from play/ only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SkinFont {
  id    String @id @default(cuid())
  type  String
  color String
  skin  Skin?
}

model SkinBorder {
  id     String @id @default(cuid())
  frame  String
  rarity Rarity
  skin   Skin?
}

model SkinBackground {
  id        String  @id @default(cuid())
  type      String
  animation String
  primary   String
  secondary String
  highlight String?
  skin      Skin?
}

model Skin {
  id String @id @default(cuid())

  name  String
  price Int

  background SkinBackground @relation(fields: [skinBackgroundId], references: [id], onDelete: Cascade)
  border     SkinBorder     @relation(fields: [skinBorderId], references: [id], onDelete: Cascade)
  font       SkinFont       @relation(fields: [skinFontId], references: [id], onDelete: Cascade)

  skinBackgroundId String @unique
  skinBorderId     String @unique
  skinFontId       String @unique

  users    UserSkin[]
  cards    Card[]
  products Product[]
}

model UserSkin {
  id String @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String
  skin   Skin   @relation(fields: [skinId], references: [id])
  skinId String

  acquiredAt DateTime @default(now())

  @@id([userId, skinId]) // Composite primary key
  @@index([skinId])
}

model Card {
  idx Int @id @default(autoincrement())

  cardId   String @unique @default(cuid())
  skinId   String
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String
  nsfw    Boolean
  visible Visibility
  tags    Tag[]      @relation("CardToTag")
  author  User       @relation(fields: [authorId], references: [id])

  skin Skin @relation(fields: [skinId], references: [id])

  health Int @default(1000000)

  decks   Deck[] @relation("CardToDeck")
  likedBy User[] @relation("CardLikesToUser")
  turns   Turn[]

  @@index([authorId])
  @@index([skinId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  cards Card[] @relation("CardToTag")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Apple `sub` for the iOS app. The refresh token is what account deletion sends to Apple.
model AppleSignIn {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sub          String   @unique
  /// Often a privaterelay address, and often present only on the first login.
  email        String?
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Opaque native session. Only the SHA-256 of the token is stored.
model BearerToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One App Store non-consumable bound to one Tappen account.
model AppleIapPurchase {
  id                    String   @id @default(cuid())
  originalTransactionId String   @unique
  transactionId         String
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId             String
  environment           String
  revokedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Deck {
  id        String    @id @default(cuid())
  name      String?
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id])
  cards     Card[]    @relation("CardToDeck")
  likedBy   User[]    @relation("DeckLikesToUser")
  rooms     Room[]

  @@index([creatorId])
}

model Room {
  id        String     @id @default(cuid())
  code      String     @unique
  status    RoomStatus @default(LOBBY)
  hostId    String?    @unique
  deckId    String?
  createdAt DateTime   @default(now())
  endedAt   DateTime?
  players   Player[]   @relation("RoomMembership")
  turns     Turn[]
  host      Player?    @relation("RoomHost", fields: [hostId], references: [id])
  deck      Deck?      @relation(fields: [deckId], references: [id])

  @@index([deckId])
  @@index([hostId])
}

model Player {
  id              String     @id @default(cuid())
  roomId          String
  displayName     String
  role            PlayerRole
  userId          String?
  connectionToken String     @unique @default(cuid())
  isConnected     Boolean    @default(true)
  lastSeenAt      DateTime?
  joinedAt        DateTime   @default(now())
  claimedAt       DateTime?
  room            Room       @relation("RoomMembership", fields: [roomId], references: [id], onDelete: Cascade)
  hostOf          Room?      @relation("RoomHost")
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  turns           Turn[]     @relation("TurnTarget")

  @@index([roomId])
  @@index([userId])
}

model Turn {
  id         String    @id @default(cuid())
  roomId     String
  cardId     String
  targetId   String?
  sequence   Int
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  card       Card      @relation(fields: [cardId], references: [cardId])
  target     Player?   @relation("TurnTarget", fields: [targetId], references: [id])

  @@index([roomId, sequence], map: "Turn_roomId_sequence_idx")
  @@index([cardId])
  @@index([targetId])
}

model User {
  id               String        @id @default(cuid())
  name             String?
  email            String?       @unique
  emailVerified    DateTime?
  image            String?
  paymentId        String?
  accounts         Account[]
  cards            Card[]
  decks            Deck[]
  sessions         Session[]
  appleSignIn      AppleSignIn?
  appleIapPurchase AppleIapPurchase?
  bearerTokens     BearerToken[]
  owned_skins      UserSkin[]
  payments         Payment[]
  liked_cards      Card[]        @relation("CardLikesToUser")
  liked_decks      Deck[]        @relation("DeckLikesToUser")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  last_newName     DateTime?
  subscription     Subscription?
  players          Player[]
  redeemedBoxCodes HomeBoxCode[]
}

model Subscription {
  id        Int       @id @default(autoincrement())
  userId    String    @unique
  stripeId  String // Store Stripe subscription ID for reference
  status    String
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Int
  type        ProductType // ENUM to indicate SKIN, BUNDLE, or SUBSCRIPTION
  skins       Skin[]
  payments    Payment[]
}

model Payment {
  id          String        @id @default(cuid())
  shopId      String?       @unique
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchasedAt DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  status      PaymentStatus @default(PENDING)

  @@index([userId])
  @@index([productId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum Rarity {
  common
  rare
  epic
  legendary
}

enum Visibility {
  PUBLIC
  SHARED
  PRIVATE
}

enum ProductType {
  SKIN
  BUNDLE
  SUBSCRIPTION
}

enum RoomStatus {
  LOBBY
  ACTIVE
  ENDED
}

enum PlayerRole {
  STAGE
  CONTROLLER
}

/// Physical preorder of the boxed Tappen Home card set.
/// Included in the PostgreSQL baseline play/prisma/migrations/0_init_postgres.
enum HomeOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  SHIPPED
}

model HomeOrder {
  id                    String          @id @default(cuid())
  stripeSessionId       String          @unique
  stripePaymentIntentId String?         @unique
  email                 String?
  name                  String?
  /// Shipping address, one line per part.
  address               String?         @db.Text
  country               String?
  quantity              Int
  /// Total charged, in cents, including VAT and shipping.
  amount                Int
  /// Shipping portion of amount, in cents.
  shippingAmount        Int?
  currency              String          @default("eur")
  status                HomeOrderStatus @default(PENDING)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  boxCodes              HomeBoxCode[]

  @@index([status])
  @@index([email])
}

/// Single-use code printed in one Tappen Home box.
/// The secret is never stored. `codeHash` is HMAC-SHA256 with BOX_CODE_PEPPER.
/// Included in the PostgreSQL baseline play/prisma/migrations/0_init_postgres.
enum HomeBoxCodeStatus {
  ISSUED
  REDEEMED
  VOID
}

model HomeBoxCode {
  id               String            @id @default(cuid())
  codeHash         String            @unique
  status           HomeBoxCodeStatus @default(ISSUED)
  homeOrderId      String?
  homeOrder        HomeOrder?        @relation(fields: [homeOrderId], references: [id], onDelete: Restrict)
  redeemedByUserId String?
  redeemedBy       User?             @relation(fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  redeemedAt       DateTime?
  voidedAt         DateTime?
  createdAt        DateTime          @default(now())

  @@index([homeOrderId])
  @@index([redeemedByUserId])
  @@index([status])
}

/// Failed guess counter. Stores an HMAC of the client IP, never a redemption code.
model HomeBoxAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
