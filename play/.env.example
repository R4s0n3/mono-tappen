# Play (play.tappen.app). Copy to .env. Do not commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tappen"
NODE_ENV="development"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional mail provider used by NextAuth. Not required to boot the client.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# HMAC pepper for Tappen Home box codes. At least 32 characters. Same value on every play process.
BOX_CODE_PEPPER=""

# Sign in with Apple for the iOS app (bundle id app.tappen.ios).
# Leave these unset and the app can still delete an account; the server logs that the Apple revoke was skipped.
# Put the .p8 contents in APPLE_PRIVATE_KEY with newlines written as \n. Do not commit the key.
# APPLE_TEAM_ID="9XGAA62775"
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""
# APPLE_CLIENT_ID="app.tappen.ios"
