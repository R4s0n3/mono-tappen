# Dev and preview only. `npm run build` always calls
# https://play.tappen.app and wss://play.tappen.app/ws, and ignores these.
#
# Vite dev/preview can proxy /api and /ws to play.tappen.app. Point these at
# the Vite origin (for example http://127.0.0.1:5173) to use that proxy.
# VITE_API_BASE_URL=http://127.0.0.1:5173
# VITE_WS_URL=ws://127.0.0.1:5173/ws
