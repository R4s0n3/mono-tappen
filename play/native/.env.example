# Build-time URLs for the iOS shell. Both have defaults in src/main.tsx
# when these are unset: https://play.tappen.app and wss://play.tappen.app/ws.
#
# Vite dev/preview can proxy /api and /ws to play.tappen.app. Point these at
# the Vite origin (for example http://127.0.0.1:5173) to use that proxy.
# VITE_API_BASE_URL=https://play.tappen.app
# VITE_WS_URL=wss://play.tappen.app/ws
