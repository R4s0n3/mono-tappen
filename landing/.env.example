# Landing (tappen.app). Copy to .env. Do not commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tappen"
NODE_ENV="development"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — same STRIPE_SECRET_KEY name as hub. Use a test key until you are ready to charge.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint below. Not the hub publishable key.
STRIPE_WEBHOOK_SECRET=""

# Tappen Home shipping, integer euro cents, VAT included.
# Example: 450 is 4,50 € within Germany, 990 is 9,90 € for the rest of the EU.
HOME_SHIPPING_DE_CENTS="450"
HOME_SHIPPING_EU_CENTS="990"
